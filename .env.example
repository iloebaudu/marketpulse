# ─── MarketPulse — configuration ───────────────────────────────────────────
# Sans aucune clé, le site tourne en MODE DÉMO (données fictives réalistes).
# Dès qu'une clé de marché est renseignée, le mode passe en « live ».
# Forcer un mode : DATA_MODE=demo | live
DATA_MODE=

# Cours en temps réel / différés (https://finnhub.io — offre gratuite : actions US)
FINNHUB_API_KEY=
# Historiques (sparklines, performances, graphiques) + cotations de secours
# (https://twelvedata.com — offre gratuite : 8 requêtes/min, 800/jour)
TWELVEDATA_API_KEY=

# Actualités complémentaires (https://newsapi.org)
NEWSAPI_KEY=
# Flux RSS activés en mode live (true par défaut)
NEWS_RSS_ENABLED=true
